[
  {
    "label": "CMake: configurar",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "CMake: compilar e executar",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build && ./build/estudos",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "CMake: executar com sanitizers",
    "command": "cmake -S . -B build-sanitize -DCMAKE_BUILD_TYPE=Debug -DENABLE_SANITIZERS=ON && cmake --build build-sanitize && ./build-sanitize/estudos",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "always",
    "allow_concurrent_runs": false
  }
]
